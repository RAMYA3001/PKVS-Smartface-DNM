    <Table TblName="vv_MissingPunchesforMonth" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="Missing Punches- this month" TblUpdatable="1" TblSQL=" CREATE view [dbo].[vv_MissingPunchesforMonth] as WITH MP as ( select top 100000 ad.RSN,ad.Department,ad.Category ,StaffId,StaffName,pidate, ROW_NUMBER() OVER ( PARTITION BY staffid,convert(varchar(11), ad.C_date,103) ORDER BY CONVERT(varchar(15),CAST(pitime AS TIME),100) --desc ) row_num from AttendanceDX AD inner join LkUpCategory LKC on ad.Category=lkc.Category inner join LkUpDept LKD on ad.Department=LKD.Department where month(ad.C_Date)=month(GETDATE()) and AStatus='PI' ), MP1 as ( select RSN,Department,Category ,StaffId,StaffName,pidate,row_num,convert(varchar(11), DATEADD(month, DATEDIFF(month, 0, getdate()), 0),113) as [From], convert(varchar(11),getdate(),113)Till from mp where row_num=1 ), MP2 as ( select --MP1.RSN, MP1.Department Dept,MP1.Category ,MP1.StaffId,MP1.StaffName [Name], convert(varchar(11), DATEADD(month, DATEDIFF(month, 0, getdate()), 0),113) as [From], convert(varchar(11),getdate(),113)Till, count(pidate)as 'P',ISNULL(DATEDIFF(d,DATEADD(m, DATEDIFF(m, 0, GETDATE()), 0),getdate())+1-count(PIDate),0) as 'NP' from MP1 --inner join StaffMaster SM on MP1.StaffId=sm.StaffId where sm.Status='Active' group by MP1.Department,MP1.Category ,MP1.StaffId,MP1.StaffName--,MP1.RSN ) select top 100000 SM.RSN,SM.Department Dept,SM.Category,SM.Team,SM.StaffId,SM.StaffName[Name], convert(varchar(11), DATEADD(month, DATEDIFF(month, 0, getdate()), 0),113) as [From], convert(varchar(11),getdate(),113)Till --mp2.[From], --MP2.Till ,isnull(P,0)P,isnull(NP,DATEDIFF(d,DATEADD(m, DATEDIFF(m, 0, GETDATE()), 0),getdate())+1)NP from MP2 right join StaffMaster SM on MP2.StaffId=sm.StaffId where sm.Status='Active' order by SM.Department,SM.Category,SM.StaffId --SELECT *FROM vv_MissingPunchesforMonth --SELECT *FROM StaffMaster " TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblFilter="&quot;[Team]='PKV'&quot;" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
