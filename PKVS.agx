    <Table TblName="VW_LatePunches" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="Late Punches" TblUpdatable="1" TblSQL=" CREATE View [dbo].[VW_LatePunches] as select top 1000000 AT.RSN,AT.StaffID,AT.StaffName,AT.Department,AT.Category,SM.Team,AT.PIDate,--convert(varchar(11),getdate(),103) as Date, AT.PITime as PITime,AT.POTime from AttendanceDX AT inner join staffmaster SM on Sm.Staffid=AT.Staffid inner join LkUpShift LS on LS.ShiftCode = sm.ShiftCode where AT.PITime&gt;LS.PIAllowedUpto and SM.Team is not null and --cast(AT.C_Date as date)=cast(getdate() as date) cast(AT.PIDate as date) between DATEADD(mm, DATEDIFF(mm, 0, Getdate())-1, 0) and cast(getdate() as date) order by SM.Team,At.StaffId,AT.PIDate --dateadd(mm,datediff(mm,0,Getdate()),0) --select AT.RSN,AT.StaffID,AT.StaffName,AT.Department,AT.Category,SM.Team,AT.PIDate,--convert(varchar(11),getdate(),103) as Date, --AT.PITime as PITime,AT.POTime from AttendanceDX AT -- inner join staffmaster SM on Sm.Staffid=AT.Staffid -- inner join LkUpShift LS on LS.ShiftCode = sm.ShiftCode -- where AT.PITime&gt;LS.PIAllowedUpto and AT.PIDate between DATEADD(mm, DATEDIFF(mm, 0, Getdate())-1, 0) and dateadd(mm,datediff(mm,0,Getdate()),0) " TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblFilter="&quot;[Team]='PKV'&quot;" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
