      <Field FldName="Mins_Worked" FldType="203" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="4000" FldAttribute="32" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Mins Worked" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagMaxLength="0" FldSelectType="Values" FldTagCols="35" FldTagRows="4" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" />
