    <Table TblName="vv_MissingPunchesPreMonth" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="Missing Punches - last month" TblUpdatable="1" TblSQL=" CREATE view [dbo].[vv_MissingPunchesPreMonth] as WITH MP as ( select top 100000 ad.RSN,ad.Department,ad.Category ,StaffId,StaffName,pidate, --select top 100000 RSN,Department,Category ,StaffId,StaffName,pidate, ROW_NUMBER() OVER ( PARTITION BY staffid,convert(varchar(11), ad.C_date,103) ORDER BY CONVERT(varchar(15),CAST(pitime AS TIME),100) --desc ) row_num from AttendanceDX ad inner join LkUpCategory LKC on ad.Category=lkc.Category inner join LkUpDept LKD on ad.Department=LKD.Department where DATEPART(m, ad.C_Date) =DATEPART(m, DATEADD(m, -1, getdate())) and AStatus='PI' ), MP1 as ( select RSN,Department,Category ,StaffId,StaffName,pidate,row_num, convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0),113) as [From], convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, -1, GETDATE())-1, -1),113)Till from mp where row_num=1 ), MP2 as ( select MP1.Department Dept,MP1.Category ,MP1.StaffId,MP1.StaffName [Name], convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0),113) as [From], convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, -1, GETDATE())-1, -1),113)Till, count(pidate)as 'P',DAY(EOMONTH(DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0)))-count(PIDate) as 'NP' from MP1 --inner join StaffMaster SM on MP1.StaffId=sm.StaffId where sm.Status='Active' group by MP1.Department,MP1.Category ,MP1.StaffId,MP1.StaffName--,MP1.RSN ) select top 100000 SM.RSN,SM.Department Dept,SM.Category,SM.Team,SM.StaffId,SM.StaffName[Name], convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0),113) as [From], convert(varchar(11),DATEADD(MONTH, DATEDIFF(MONTH, -1, GETDATE())-1, -1),113)Till, --mp2.[From], --MP2.Till isnull(P,0)P,isnull(NP,DAY(EOMONTH(DATEADD(MONTH, DATEDIFF(MONTH, 0, GETDATE())-1, 0))))NP from MP2 right join StaffMaster SM on MP2.StaffId=sm.StaffId where sm.Status='Active' order by SM.Department,SM.Category,SM.Team,SM.StaffId --select SM.RSN,MP2.Dept,MP2.Category,MP2.StaffId,MP2.[Name],mp2.[From],MP2.Till,P,NP from MP2 --right join StaffMaster SM on MP2.StaffId=sm.StaffId where sm.Status='Active' --SELECT *FROM vv_MissingPunchesPreMonth --SELECT *FROM StaffMaster " TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblFilter="&quot;[Team]='PKV'&quot;" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
      <Field FldName="RSN" FldType="131" FldTypeName="decimal" NativeDataType="5" FldSupport="1" FldSort="0" FldSize="17" FldReq="1" FldIsPrimaryKey="1" FldAttribute="4" FldValidate="FLOAT" FldRequired="1" FldGenerate="1" FldView="1" FldAddOpt="1" FldSearch="1" FldSrchOpr="USER SELECT" FldCaption="RSN" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="Number" FldNumDigits="2" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldColumnWrap="0" FldMultiUpdate="1" />
      <Field FldName="Team" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Team" FldViewTag="FORMATTED TEXT" FldHtmlTag="SELECT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Table" FldTagLnkTbl="LkUpTeam" FldTagLnkFld="TeamCode" FldTagLnkDisplay="TeamCode" FldTagLnkDisp2="TeamName" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Dept" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldReq="1" FldAttribute="4" FldRequired="1" FldGenerate="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Dept" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
