    <Table TblName="vw_AttendanceCurMonthRegister_PKV" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="This month register" TblUpdatable="1" TblSQL=" CREATE VIEW [dbo].[vw_AttendanceCurMonthRegister_PKV] AS WITH PIT AS ( SELECT RSN, CONVERT(VARCHAR(11), ad.C_Date, 113) AS [Date], ad.Department AS Dept, ad.Category, ad.StaffId AS EmpId, AD.StaffName AS [Name], CONVERT(VARCHAR(15), CAST(PITime AS TIME), 100) AS [In], ROW_NUMBER() OVER ( PARTITION BY CONVERT(VARCHAR(11), C_date, 103), staffid ORDER BY StaffId ) AS row_num FROM AttendanceDx AD WHERE MONTH(AD.C_Date) = MONTH(GETDATE()) AND YEAR(AD.C_Date) = YEAR(GETDATE()) AND PITime IS NOT NULL ), POT AS ( SELECT RSN, CONVERT(VARCHAR(11), ad.C_Date, 113) AS [Date], ad.Department AS Dept, ad.Category, ad.StaffId AS EmpId, AD.StaffName AS [Name], CONVERT(VARCHAR(15), CAST(POTime AS TIME), 100) AS [Out], ROW_NUMBER() OVER ( PARTITION BY CONVERT(VARCHAR(11), C_date, 103), staffid ORDER BY StaffId ) AS row_num2 FROM AttendanceDx AD WHERE MONTH(AD.C_Date) = MONTH(GETDATE()) AND YEAR(AD.C_Date) = YEAR(GETDATE()) AND POTime IS NOT NULL AND PODate IS NOT NULL AND PITime IS NOT NULL ) SELECT DISTINCT TOP 100000 PIT.RSN, PIT.Dept, PIT.Category, SM.Team, PIT.EmpId, PIT.Name, PIT.Date, PIT.[In], POT.[Out], -- Hours Worked CAST(DATEDIFF(MINUTE, CAST([In] AS TIME), CASE WHEN CAST([Out] AS TIME) &gt; '18:30' THEN CAST('18:30' AS TIME) ELSE CAST([Out] AS TIME) END ) / 60 AS VARCHAR(8)) AS [Hrs_Worked], -- Minutes Worked FORMAT( DATEDIFF(MINUTE, CAST([In] AS TIME), CASE WHEN CAST([Out] AS TIME) &gt; '18:30' THEN CAST('18:30' AS TIME) ELSE CAST([Out] AS TIME) END ) % 60, 'D2') AS [Mins_Worked], LC.Wage AS [Wage (Per Hour)], -- Earned Wage CAST( CASE WHEN LC.Wage IS NOT NULL THEN ( (DATEDIFF(MINUTE, CAST([In] AS TIME), CASE WHEN CAST([Out] AS TIME) &gt; '18:30' THEN CAST('18:30' AS TIME) ELSE CAST([Out] AS TIME) END ) / 60.0) * CAST(LC.Wage AS FLOAT) ) ELSE 0.00 END AS DECIMAL(10,2)) AS [Earned_Wage], AD1.GEOLocation AS 'Latitute,Longitude', -- Distance Calculation ROUND( 6371000 * ACOS( COS(RADIANS(ISNULL(WS.Latitude, 0))) * COS(RADIANS(ISNULL(AD1.Latitude, 0))) * COS(RADIANS(ISNULL(AD1.Longitude, 0)) - RADIANS(ISNULL(WS.Longitude, 0))) + SIN(RADIANS(ISNULL(WS.Latitude, 0))) * SIN(RADIANS(ISNULL(AD1.Latitude, 0))) ), 2 ) AS DistanceInMeters, CASE WHEN 6371000 * ACOS( COS(RADIANS(ISNULL(WS.Latitude, 0))) * COS(RADIANS(ISNULL(AD1.Latitude, 0))) * COS(RADIANS(ISNULL(AD1.Longitude, 0)) - RADIANS(ISNULL(WS.Longitude, 0))) + SIN(RADIANS(ISNULL(WS.Latitude, 0))) * SIN(RADIANS(ISNULL(AD1.Latitude, 0))) ) &lt;= 20 THEN 'Yes' ELSE 'No' END AS OnWorkSite FROM PIT LEFT JOIN POT ON PIT.Date = POT.Date AND PIT.EmpId = POT.EmpId AND POT.row_num2 = 1 INNER JOIN StaffMaster SM ON SM.StaffId = PIT.EmpId AND SM.Status = 'Active' INNER JOIN LkUpCategory LC ON LC.Team = SM.Team AND LC.Category = SM.Category INNER JOIN AttendanceD AD1 ON AD1.StaffId = PIT.EmpId AND CONVERT(VARCHAR(11), AD1.C_Date, 113) = PIT.Date INNER JOIN LkUppkvWorkSite WS ON WS.WorkSite = AD1.WorkSite WHERE PIT.row_num = 1 AND SM.Team = 'PKV' O" TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblFilter="&quot;[Team]='PKV'&quot;" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
      <Field FldName="RSN" FldType="3" FldTypeName="int" NativeDataType="8" FldSupport="1" FldSort="0" FldSize="4" FldReq="1" FldIsPrimaryKey="1" FldAttribute="4" FldValidate="INTEGER" FldRequired="1" FldGenerate="1" FldView="1" FldAddOpt="1" FldSrchOpr="USER SELECT" FldCaption="RSN" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="Number" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldColumnWrap="0" />
      <Field FldName="Dept" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldAttribute="36" FldGenerate="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Dept" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
