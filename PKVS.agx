    <Table TblName="vw_AttendanceforDay_PKV" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="Daily register" TblUpdatable="1" TblSQL=" CREATE VIEW [dbo].[vw_AttendanceforDay_PKV] AS WITH CTEReport AS ( SELECT A.RSN, CONVERT(VARCHAR(11), A.C_Date, 113) AS [Date], A.Department AS Dept, A.Category, A.StaffId AS EmpId, A.StaffName AS [Name], A.C_Date AS OrgDate, CONVERT(VARCHAR(15), CAST(A.PITime AS TIME), 100) AS [In], A.AStatus, A.WorkSite, ROW_NUMBER() OVER ( PARTITION BY CAST(A.C_Date AS DATE), A.StaffId ORDER BY A.PITime ) AS row_num FROM AttendanceDX A WHERE A.PITime IS NOT NULL ), SingleAttendance AS ( SELECT AD1.* FROM AttendanceD AD1 JOIN ( SELECT StaffId, CAST(C_Date AS DATE) AS ADate, MIN(RSN) AS MinRSN FROM AttendanceD GROUP BY StaffId, CAST(C_Date AS DATE) ) AS FirstPunch ON AD1.StaffId = FirstPunch.StaffId AND CAST(AD1.C_Date AS DATE) = FirstPunch.ADate AND AD1.RSN = FirstPunch.MinRSN ) SELECT DISTINCT TOP 100000 CT.RSN, CT.Dept, CT.Category, SM.Team, CT.EmpId, CT.Name, CT.AStatus AS [Status], CT.[Date], CT.[In], AD.GEOLocation AS 'Latitute,Longitude', -- Distance calculation using Haversine formula ROUND( 6371000 * ACOS( COS(RADIANS(ISNULL(WS.Latitude, 0))) * COS(RADIANS(ISNULL(AD.Latitude, 0))) * COS(RADIANS(ISNULL(AD.Longitude, 0)) - RADIANS(ISNULL(WS.Longitude, 0))) + SIN(RADIANS(ISNULL(WS.Latitude, 0))) * SIN(RADIANS(ISNULL(AD.Latitude, 0))) ), 2 ) AS DistanceInMeters, CASE WHEN 6371000 * ACOS( COS(RADIANS(ISNULL(WS.Latitude, 0))) * COS(RADIANS(ISNULL(AD.Latitude, 0))) * COS(RADIANS(ISNULL(AD.Longitude, 0)) - RADIANS(ISNULL(WS.Longitude, 0))) + SIN(RADIANS(ISNULL(WS.Latitude, 0))) * SIN(RADIANS(ISNULL(AD.Latitude, 0))) ) &lt;= 20 THEN 'Yes' ELSE 'No' END AS OnWorkSite FROM CTEReport CT INNER JOIN SingleAttendance AD ON CT.EmpId = AD.StaffId AND CAST(CT.OrgDate AS DATE) = CAST(AD.C_Date AS DATE) INNER JOIN StaffMaster SM ON SM.StaffId = CT.EmpId INNER JOIN LkUppkvWorkSite WS ON WS.WorkSite = CT.WorkSite WHERE CT.row_num = 1 AND CT.[In] IS NOT NULL AND CAST(CT.OrgDate AS DATE) = CAST(GETDATE() AS DATE) AND CT.WorkSite = 'PKV' ORDER BY CT.EmpId ASC; -- ✅ Now allowed because of TOP 100 PERCENT " TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
      <Field FldName="RSN" FldType="3" FldTypeName="int" NativeDataType="8" FldSupport="1" FldSort="0" FldSize="4" FldReq="1" FldIsPrimaryKey="1" FldAttribute="4" FldValidate="INTEGER" FldRequired="1" FldGenerate="1" FldView="1" FldAddOpt="1" FldSrchOpr="USER SELECT" FldCaption="RSN" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="Number" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldColumnWrap="0" />
      <Field FldName="Dept" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldAttribute="36" FldGenerate="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Dept" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Category" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldAttribute="36" FldGenerate="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Category" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Team" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Team" FldViewTag="FORMATTED TEXT" FldHtmlTag="SELECT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Table" FldTagLnkTbl="LkUpTeam" FldTagLnkFld="TeamCode" FldTagLnkDisplay="TeamCode" FldTagLnkDisp2="TeamName" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="EmpId" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="12" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Emp Id" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="12" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldOrderBy="1" FldOrder="ASC" FldMultiUpdate="1" />
      <Field FldName="Name" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="80" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Name" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="80" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Status" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="2" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Status" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="2" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Date" FldType="200" FldTypeName="varchar" NativeDataType="22" FldSupport="1" FldSize="11" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Date" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="11" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="In" FldType="200" FldTypeName="varchar" NativeDataType="22" FldSupport="1" FldSize="15" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="In" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="15" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
