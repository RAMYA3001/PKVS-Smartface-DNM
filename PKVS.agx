    <Table TblName="MVStatussummary" TblType="VIEW" TblGen="1" TblList="1" TblCaption="MVStatussummary" TblUpdatable="1" TblSQL=" CREATE VIEW [dbo].[MVStatussummary] AS WITH Temp as( select MM.MVContractor, sum(case when MM.MVStatus='20' then 1 else 0 end) AS 'Totcount', sum(case when MM.MVStatus='10' then 1 else 0 end) AS 'INApprove', sum(case when MM.MVStatus='00' then 1 else 0 end) AS 'Submitted', sum(case when MM.MVStatus='20' and cast(MM.MVValidityEndDate as DATE) &lt;= cast(DATEADD(day, 30, getdate()) as DATE) then 1 else 0 end) AS 'Validityend', sum(case when MM.MVStatus='ZZ' then 1 else 0 end) AS 'ValidityOver' from MVMaster MM group by MM.MVContractor ), Tempstatus AS ( select MM.MVContractor , sum(case when MM.MVStatus='20' then 1 else 0 end) AS 'Approved', sum(case when MM.MVStatus='YY' then 1 else 0 end) AS 'Reject' from MVMaster MM where cast(MM.MVStatusDate as date) between CAST(GETDATE()-7 as date) and CAST(GETDATE() as date) group by MM.MVContractor ) select MM.MVContractor,MM.Totcount,isnull(MM.Submitted,0)Submitted,isnull(T.Approved,0)Approved,isnull(T.Reject,0)Reject,MM.Validityend,MM.INApprove,MM.ValidityOver from Temp MM left join Tempstatus T on T.MVContractor = MM.MVContractor " TblSrchType="BASIC" TblBasicSearch="1" TblExtendedBasicSearch="1" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
      <Field FldName="MVContractor" FldType="202" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="8" FldReq="1" FldAttribute="4" FldRequired="1" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="LIKE" FldCaption="MVContractor" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="8" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="Totcount" FldType="3" FldTypeName="int" NativeDataType="8" FldSupport="1" FldSize="4" FldAttribute="36" FldValidate="INTEGER" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldSrchOpr="=" FldCaption="Totcount" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="Number" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldMultiUpdate="1" />
