    <Table TblName="vv_SFSTATS" TblType="VIEW" TblGen="1" TblList="1" TblView="1" TblCaption="Summary" TblUpdatable="1" TblSQL=" CREATE view [dbo].[vv_SFSTATS] as select top 100000 sf.RSN,convert(varchar(11),StatsDate,113)Date,Department Dept,Category, Team,LPCt,StaffCt,[PICt] as 'PI Ct',[PoCt]as 'PO Ct', LVCt as 'Onleave',PNCt as 'PN Ct',HN80Ct as 'HN Ct' from SFSTATS Sf --inner join lkupteam Lt on Sf.team=lt.teamcode order by StatsDate desc--,Department,Category " TblSrchType="BASIC" TblSearch="1" TblBasicSearch="1" TblExtendedBasicSearch="1" TblFilter="&quot;[Team]='PKV'&quot;" TblSecurity="0,&quot;Default&quot;,0" TblLoaded="1" TblShowEmptyRows="0" TblUseGlobal="1" TblRecPerPage="20" TblRecPerPageList="10,20,50,ALL" TblGrpPerPage="3" TblGrpPerPageList="1,2,3,5,ALL" TblPagerStyle="2" TblUseButtonsForLinks="1" TblUseDropDownForAction="1" TblUseDropDownForListOptions="1" TblUseDropDownForExport="1">
