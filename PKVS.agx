      <Field FldName="Earned_Wage" FldType="131" FldTypeName="decimal" NativeDataType="5" FldSupport="1" FldSize="17" FldAttribute="32" FldValidate="FLOAT" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldAddOpt="1" FldSearch="1" FldSrchOpr="USER SELECT" FldCaption="Earned Wage" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="Number" FldNumDigits="2" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" />
      <Field FldName="OnWorkSite" FldType="200" FldTypeName="varchar" NativeDataType="22" FldSupport="1" FldSize="3" FldReq="1" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Punched at location?" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="3" FldSelectType="Values" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" />
      <Field FldName="Latitute,Longitude" FldType="203" FldTypeName="nvarchar" NativeDataType="12" FldSupport="1" FldSize="256" FldAttribute="36" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldEdit="1" FldAdd="1" FldAddOpt="1" FldSearch="1" FldBasicSearch="1" FldSrchOpr="USER SELECT" FldCaption="Latitute,Longitude" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagMaxLength="0" FldSelectType="Values" FldTagCols="35" FldTagRows="4" FldTagAPrefix="None" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" FldQuoteS="'" FldQuoteE="'" FldMultiUpdate="1" />
      <Field FldName="DistanceInMeters" FldType="5" FldTypeName="float" NativeDataType="6" FldSupport="1" FldSize="8" FldAttribute="32" FldValidate="FLOAT" FldGenerate="1" FldList="1" FldExport="1" FldView="1" FldAddOpt="1" FldSearch="1" FldSrchOpr="USER SELECT" FldCaption="Punch Point Distance (m)" FldViewTag="FORMATTED TEXT" FldHtmlTag="TEXT" FldTagSize="30" FldTagMaxLength="0" FldSelectType="Values" FldTagAPrefix="None" FldFmtType="String" FldNumDigits="2" FldIncLeadDigit="-2" FldUseParen="-2" FldGpDigits="-2" />
